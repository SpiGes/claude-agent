#!/usr/bin/env bash
# Runs the standalone security ESLint (see /opt/eslint-security) on the given files or folders.
# The configuration of the analysed project is ignored (--no-config-lookup), and so are its inline
# eslint-disable comments (--no-inline-config), which refer to rules unknown to this configuration.
# Options that change files or load another configuration are refused, so that the command stays read-only.
# Usage: eslint-security [-f json] [-o <report file>] <path>...
set -euo pipefail

home=/opt/eslint-security

for argument in "$@"; do
    case "$argument" in
        --fix|--fix-dry-run|--fix-type*|-c|--config*|--plugin*|--rulesdir*|--resolve-plugins-relative-to*|--cache*)
            echo "eslint-security: option not allowed: $argument" >&2
            exit 2
            ;;
    esac
done

exec "$home/node_modules/.bin/eslint" --config "$home/eslint.config.mjs" --no-config-lookup --no-inline-config "$@"
