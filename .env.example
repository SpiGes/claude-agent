CLAUDE_CODE_OAUTH_TOKEN=<to be generated via "claude setup-token">

# Dedicated Azure DevOps PAT for Git operations (Code, Read & Write scope),
# distinct from DEVOPS_PAT used by the Azure DevOps MCP server.
# See the full setup guide, Chapter 3, for how this is generated and used.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=http.https://devops-server.admin.ch.extraHeader
GIT_CONFIG_VALUE_0=Authorization: Basic <PAT in base64, e.g. printf ':%s' '<PAT>' | base64 -w0>

# --- Optional: GitHub access (see "Optional: GitHub access" in README.md). ---
# Left commented out when GitHub is not used: a placeholder token sent to github.com
# would make every request fail, public repositories included. To enable it, uncomment
# the four lines below and raise GIT_CONFIG_COUNT above to 2.

# Dedicated GitHub fine-grained PAT of the agent account for Git operations
# (Contents: Read and write), distinct from the PAT used for GitHub API actions below.
#GIT_CONFIG_KEY_1=http.https://github.com/.extraHeader
#GIT_CONFIG_VALUE_1=Authorization: Basic <PAT in base64, e.g. printf 'x-access-token:%s' '<PAT>' | base64 -w0>

# Commit email of the GitHub agent account, used only for repositories with a github.com
# remote. Shown in the agent account's Settings > Emails when "Keep my email addresses
# private" is enabled.
#GITHUB_COMMIT_EMAIL=<ID>+<login>@users.noreply.github.com

# Dedicated GitHub fine-grained PAT of the agent account for GitHub API actions via `gh`
# (Issues and Pull requests: Read and write; Contents: Read-only), distinct from the Git
# PAT above. Plain token, read by `gh` directly, no base64.
#GH_TOKEN=<PAT>
