CLAUDE_CODE_OAUTH_TOKEN=<to be generated via "claude setup-token">

# The Git tokens (Azure DevOps, GitHub, Bitbucket) and the GitHub API token of gh aren't set here: they're in
# the encrypted secrets file of the secret broker (see "Secret broker" in README.md, and broker/secrets.example),
# handed out to the agent only while their group is open. The same goes for the tokens of the MCP servers
# (DEVOPS_PAT, JIRA_PERSONAL_TOKEN, CONFLUENCE_PERSONAL_TOKEN), each handed only to its own container (see "MCP
# gateway" in README.md).

# Commit authorship of the agent for repositories on the Azure DevOps Server. Required: the
# container refuses to start without them. Chosen by each person, e.g.
# "Claude Agent (Firstname Lastname)" and "firstname.lastname+agent-dev@example.org".
DEVOPS_COMMIT_NAME=<agent name, e.g. Claude Agent (Firstname Lastname)>
DEVOPS_COMMIT_EMAIL=<agent email address>

# --- Optional: GitHub access (see "Optional: GitHub access" in README.md). ---
# Commit authorship of the agent for repositories with a github.com remote, set once its tokens are in the
# secrets file. The email is the agent account's noreply address, shown in its Settings > Emails when "Keep my
# email addresses private" is enabled.
#GITHUB_COMMIT_NAME=<agent name, e.g. Claude Agent (Firstname Lastname)>
#GITHUB_COMMIT_EMAIL=<ID>+<login>@users.noreply.github.com

# --- Optional: Bitbucket access (see "Optional: Bitbucket access" in README.md). ---
# Commit authorship of the agent for repositories with a bitbucket.bit.admin.ch remote, set once its tokens are
# in the secrets file. Chosen by each person, like the Azure DevOps pair.
#BITBUCKET_COMMIT_NAME=<agent name, e.g. Claude Agent (Firstname Lastname)>
#BITBUCKET_COMMIT_EMAIL=<agent email address>

# --- Optional: local runs of the SpiGes backend (backend-run skill, backend repository). ---
# Folder of the personal backend settings, kept out of the repositories (e.g. under /shared):
# appsettings.custom.REF.json and appsettings.custom.TST.json. The appsettings.custom.json of a
# checkout or worktree is a symbolic link to one of them.
#SPIGES_BACKEND_SETTINGS_DIR=<folder of the settings files>

# --- Optional: personal CA certificates. ---
# Folder of PEM certificates (*.crt, *.pem) trusted in addition to the ones of the image, e.g. the
# self-signed certificate of the MinIO used by a local run of the SpiGes backend. Kept out of the
# repositories, e.g. under /shared. Read at each start of the container.
#EXTRA_CA_CERTS_DIR=<folder of the certificates>

# --- Optional: SpiGes tokens for local endpoint tests and DB tooling. ---
# Read by the token script of the backend-run skill (backend repository) to request a token
# (client credentials) on the Keycloak realm used by REF and TST, for a SpiGes user (site,
# enterprise, canton, BFS, EMPF) or a technical SIS client.
# Path of the clients file: one "<profile>=<client id>" line per client, e.g. "canton-ne=<client id>"
# or "spiges=BFS.SIS.SpiGes" (the technical client used by the spiges-sql skill --processing-run).
# Kept out of the repositories, e.g. under /shared.
#SPIGES_KEYCLOAK_CLIENTS_FILE=<path of the clients file>
# Client secret: per profile SPIGES_KEYCLOAK_<PROFILE>_CLIENT_SECRET (profile upper-cased, "-" -> "_",
# e.g. SPIGES_KEYCLOAK_SPIGES_CLIENT_SECRET, SPIGES_KEYCLOAK_SAS_CLIENT_SECRET), falling back to the
# shared SPIGES_KEYCLOAK_USER_CLIENT_SECRET for the user clients.
#SPIGES_KEYCLOAK_USER_CLIENT_SECRET=<shared secret of the user clients>
#SPIGES_KEYCLOAK_SPIGES_CLIENT_SECRET=<secret of the BFS.SIS.SpiGes technical client>

# --- Optional: SpiGes database read access for the spiges-sql skill (backend repository). ---
# Read-only SQL on the non-production Oracle databases, used for self-validation. REF and TST are the
# same physical database (service EDWHPDSRV); they differ only by the account and its schema. The
# passwords differ per environment, and PRD is a separate database, so these credentials can't reach it.
# The datasource is the full connect descriptor (as resolved from the LDAP entry EDWHPD_CM).
#SPIGES_ORACLE_REF_USER=<REF account>
#SPIGES_ORACLE_REF_PASSWORD=<REF password>
#SPIGES_ORACLE_REF_DATASOURCE=<REF connect descriptor>
#SPIGES_ORACLE_TST_USER=<TST account>
#SPIGES_ORACLE_TST_PASSWORD=<TST password>
#SPIGES_ORACLE_TST_DATASOURCE=<TST connect descriptor>
# Optional: connection string of the local Postgres (the "local" target). Without it, the skill uses the
# default settings of the backend appsettings.json (localhost:5432, reached through the backend-run
# port forwarding). The local Postgres runs on the developer machine or in Docker.
#SPIGES_POSTGRES_LOCAL_CONNECTION_STRING=<Npgsql connection string>

# --- Optional: SAS server access. ---
#SPIGES_SAS_REF_SSH_USER=<account>
#SPIGES_SAS_REF_SSH_PASSWORD=<password>

# --- Optional: notifications (see "Optional: speech notifications" in README.md). ---
# Text of the notification sent when a new session starts, read by the SessionStart hook of the dev profile.
# Default: "Bonjour, je suis prêt". An empty value disables the greeting. No apostrophe.
#AGENT_NOTIFY_GREETING_TEXT=<text>
# Text of the notification sent when the agent waits for a permission, read by the Notification hook of the dev profile.
# Default: "Autorisation requise". No apostrophe.
#AGENT_NOTIFY_PERMISSION_TEXT=<text>
