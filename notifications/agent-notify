#!/usr/bin/env bash
# Sends a notification of the agent, run in the container. Entry point used by the agent and by the hooks,
# whatever the channel; the only channel so far is speech: the text is queued for the speech relay on the
# WSL host (notifications/speak-relay.sh).
# The text is prefixed with the name of the agent workspace (AGENT_NOTIFY_NAME), so that several agents
# running at the same time can be told apart.
#
# Speech channel: does nothing when it isn't set up for this container (see launch.sh), or when it's muted.
# The mute is global: a .muted file in the speech queue folder, shared by every agent of the person, kept
# until it's removed with --speech-on.
#
# Usage: agent-notify <text>          sends the text
#        agent-notify --speech-off    mutes the speech notifications of every agent
#        agent-notify --speech-on     unmutes them
#        agent-notify --status        prints the current state
set -euo pipefail

[ $# -gt 0 ] || { echo "Usage: agent-notify <text> | --speech-off | --speech-on | --status" >&2; exit 2; }
speech_dir="${AGENT_NOTIFY_SPEECH_DIR:-}"
speech_set_up=0
{ [ -n "$speech_dir" ] && [ -d "$speech_dir" ]; } && speech_set_up=1
speech_muted_file="$speech_dir/.muted"

status(){
    if [ "$speech_set_up" = 0 ]; then
        echo "Speech notifications aren't set up for this agent (AGENT_NOTIFY_SPEECH=0, or no speech engine on the host when it was launched)."
    elif [ -e "$speech_muted_file" ]; then
        echo "Speech notifications are muted for every agent."
    else
        echo "Speech notifications are on for every agent."
    fi
}

case "$1" in
    --speech-off) [ "$speech_set_up" = 0 ] || touch "$speech_muted_file"; status; exit 0 ;;
    --speech-on) [ "$speech_set_up" = 0 ] || rm -f -- "$speech_muted_file"; status; exit 0 ;;
    --status) status; exit 0 ;;
    --*) echo "agent-notify: unknown option $1" >&2; exit 2 ;;
esac

text="$*"
[ -z "${AGENT_NOTIFY_NAME:-}" ] || text="$AGENT_NOTIFY_NAME: $text"

# Speech: written under a temporary name first, so that the relay never reads a partial file
if [ "$speech_set_up" = 1 ] && [ ! -e "$speech_muted_file" ]; then
    name="$(date +%Y%m%d-%H%M%S-%N)-${HOSTNAME:-agent}-$$"
    printf '%s\n' "$text" > "$speech_dir/$name.tmp"
    mv "$speech_dir/$name.tmp" "$speech_dir/$name.txt"
fi
