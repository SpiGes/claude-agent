#!/usr/bin/env bash
# Starts a security analysis tool without the secrets of the agent environment: tokens and passwords of the
# .env file (GIT_CONFIG_*, GH_TOKEN, SPIGES_*, and so on) aren't passed to it, so that a compromised release
# can't read them from its environment. The files of the home stay readable (see README, "Installation details").
# Installed as /opt/security-tools/security-tool; /usr/local/bin/<tool> is a symbolic link to it, and the real
# tool is /opt/security-tools/bin/<tool>, out of the PATH.
set -euo pipefail

tool="$(basename "$0")"
binary="/opt/security-tools/bin/$tool"
if [ ! -x "$binary" ]; then
    echo "security-tool: unknown tool: $tool" >&2
    exit 2
fi

# Dedicated home of the tools, in the cache of the slot home: their configuration and caches (Trivy database,
# semgrep and pip-audit caches) live there.
tool_home="${HOME:?}/.cache/security-tools"
mkdir -p "$tool_home"

environment=(
    HOME="$tool_home"
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    LANG=C.UTF-8
)
# Certificates of the corporate proxy, terminal, and proxy settings: the only variables the tools need.
for name in SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE NODE_EXTRA_CA_CERTS TERM \
    HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
    if [ -n "${!name:-}" ]; then
        environment+=("$name=${!name}")
    fi
done

exec env -i "${environment[@]}" "$binary" "$@"
