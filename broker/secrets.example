# Secrets file of the secret broker (see "Secret broker" in README.md), edited with `claude_secret edit`, which
# keeps it encrypted with age in ~/.claude-agent-homes/vault/secrets.age. Never written in clear to the disk of
# the host.
# One KEY=VALUE per line, as a docker env file: no quotes, no space around "=", no trailing space.

# --- Git tokens (group "git", opened with `claude_secret allow git`) ---
# One numbered entry per token: GIT_<n>_URL, and either GIT_<n>_PASSWORD (Basic authentication, with
# GIT_<n>_USERNAME, default "token") or GIT_<n>_BEARER. The URL is an https:// prefix, compared without regard
# to case: the longest prefix that matches the URL of the remote wins. The tokens are plain, not base64-encoded.

# Azure DevOps Server: Git PAT of the agent (Code, Read & Write).
GIT_1_URL=https://devops-server.admin.ch
GIT_1_PASSWORD=<PAT>

# Optional: GitHub, one Git token of the agent account per organization (Contents: Read and write), since a
# fine-grained token belongs to a single organization.
#GIT_2_URL=https://github.com/<organization>
#GIT_2_USERNAME=x-access-token
#GIT_2_PASSWORD=<token>

# Optional: Bitbucket, one HTTP access token per repository, with the exact URL of the remote (".git"
# included). Bitbucket tokens are Bearer tokens.
#GIT_3_URL=https://bitbucket.bit.admin.ch/scm/<project>/<repository>.git
#GIT_3_BEARER=<token>

# --- GitHub API tokens of gh (group "gh", opened with `claude_secret allow gh`) ---
# Optional: one API token of the agent account per organization (Issues and Pull requests: Read and write;
# Contents: Read-only), as GH_<NAME>_TOKEN with the organization in GH_<NAME>_OWNER. A plain GH_TOKEN, without
# owner, serves any other organization.
#GH_SPIGES_TOKEN=<token>
#GH_SPIGES_OWNER=SpiGes

# --- Secrets of type 2 (see "MCP gateway" in README.md) ---
# Handed only to the container of an MCP server, by `claude_mcp start` on the host; never to the agent container.
# Azure DevOps PAT of the MCP server (Work Items: Read & Write, Code: Read & Write), plain.
#DEVOPS_PAT=<PAT>
# Jira Data Center personal access token of the Jira MCP server, plain (the server runs read only).
#JIRA_PERSONAL_TOKEN=<personal access token>
# Confluence Data Center personal access token of the Confluence MCP server, plain.
#CONFLUENCE_PERSONAL_TOKEN=<personal access token>
# Keycloak client secrets of the Keycloak MCP server (REF and TST realm), plain: per profile
# SPIGES_KEYCLOAK_<PROFILE>_CLIENT_SECRET (profile upper-cased, "-" -> "_"), falling back to the shared
# SPIGES_KEYCLOAK_USER_CLIENT_SECRET for the user clients. The three below are handed to the server (claude_mcp);
# SPIGES_KEYCLOAK_SPIGES_CLIENT_SECRET also to the Oracle MCP server, for the processing areas.
#SPIGES_KEYCLOAK_USER_CLIENT_SECRET=<shared secret of the user clients>
#SPIGES_KEYCLOAK_SAS_CLIENT_SECRET=<secret of the BFS.SIS.SAS client>
#SPIGES_KEYCLOAK_SPIGES_CLIENT_SECRET=<secret of the BFS.SIS.SpiGes technical client>
# Account of the SAS server of REF (technical account shared with the SpiGes backend), of the SAS MCP server, plain.
#SPIGES_SAS_REF_SSH_USER=<account>
#SPIGES_SAS_REF_SSH_PASSWORD=<password>
# Accounts of the REF and TST SpiGes Oracle databases (shared accounts, with write rights), of the Oracle MCP server,
# plain. REF and TST are the same physical database (service EDWHPDSRV), with different accounts and schemas; PRD is
# a separate database, which the server refuses. The datasource is the full connect descriptor (as resolved from the
# LDAP entry EDWHPD_CM).
#SPIGES_ORACLE_REF_USER=<REF account>
#SPIGES_ORACLE_REF_PASSWORD=<REF password>
#SPIGES_ORACLE_REF_DATASOURCE=<REF connect descriptor>
#SPIGES_ORACLE_TST_USER=<TST account>
#SPIGES_ORACLE_TST_PASSWORD=<TST password>
#SPIGES_ORACLE_TST_DATASOURCE=<TST connect descriptor>
