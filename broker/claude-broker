#!/usr/bin/env python3
"""Secret broker of the agent (see README, "Secret broker").

Runs in its own container (claude-broker, started by launch.sh), next to the agent containers. It keeps the
secrets of an age-encrypted file in memory, and hands them out to the agent only while their group is open.
A group is opened and closed on the host with claude_secret, through `docker exec`, which the agent container
can't use: the agent can't open a group by itself. A group closes BROKER_IDLE_MINUTES after its last use, and
BROKER_MAX_HOURS after it was opened, whichever comes first.

Usage:
    claude-broker serve                   runs the service (command of the container)
    claude-broker ctl load                loads the decrypted secrets file, read on stdin
    claude-broker ctl allow <group>       opens a group
    claude-broker ctl revoke <group>|all  closes a group, or every group
    claude-broker ctl status              prints the state of the broker and of each group
    claude-broker ctl unlocked            exits with 0 when the secrets are loaded, 1 otherwise (3: service not ready)
    claude-broker ctl lock                forgets the secrets and closes every group

Secrets file (one KEY=VALUE per line, as a docker env file; see secrets.example):
    GIT_<n>_URL, GIT_<n>_USERNAME, GIT_<n>_PASSWORD or GIT_<n>_BEARER   a Git token (group "git")
    GH_TOKEN                                                            the GitHub API token of gh (group "gh")

Every request and every command is logged to BROKER_LOG, never with a secret value.
"""

import json
import os
import re
import socket
import socketserver
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("BROKER_PORT", "8080"))
IDLE_SECONDS = int(float(os.environ.get("BROKER_IDLE_MINUTES", "30")) * 60)
MAX_SECONDS = int(float(os.environ.get("BROKER_MAX_HOURS", "4")) * 3600)
LOG_FILE = os.environ.get("BROKER_LOG", "/log/broker.log")
ADMIN_SOCKET = os.environ.get("BROKER_ADMIN_SOCKET", "/tmp/claude-broker/admin.sock")
NOTIFY_INTERVAL_SECONDS = 120
MAX_REQUEST_BYTES = 64 * 1024

GROUPS = ("git", "gh")
KEY_PATTERN = re.compile(r"^[A-Z][A-Z0-9_]*$")
GIT_KEY_PATTERN = re.compile(r"^GIT_(\d+)_(URL|USERNAME|PASSWORD|BEARER)$")
DEFAULT_GIT_USERNAME = "token"


class BrokerError(Exception):
    """An error returned to the caller, with an HTTP status for the service."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def log(event):
    line = f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {event}\n"
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as file:
            file.write(line)
    except OSError as error:
        sys.stderr.write(f"claude-broker: log not written ({error}): {line}")


def format_duration(seconds):
    minutes = max(0, int(seconds // 60))
    return f"{minutes // 60} h {minutes % 60:02d} min" if minutes >= 60 else f"{minutes} min"


def parse_secrets(text):
    """Parses the decrypted secrets file. Returns (git entries, other secrets); raises ValueError with the
    line numbers of the errors, never with a value."""
    values, errors = {}, []
    for number, raw in enumerate(text.splitlines(), start=1):
        line = raw.rstrip("\r")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not KEY_PATTERN.match(key):
            errors.append(f"line {number}: expected KEY=VALUE")
        elif value != value.strip():
            errors.append(f"line {number}: {key} starts or ends with a space")
        elif not value:
            errors.append(f"line {number}: {key} is empty")
        else:
            values[key] = value

    git, others = {}, {}
    for key, value in values.items():
        match = GIT_KEY_PATTERN.match(key)
        if match:
            git.setdefault(match.group(1), {})[match.group(2)] = value
        else:
            others[key] = value

    entries = []
    for index, fields in sorted(git.items(), key=lambda item: int(item[0])):
        url = fields.get("URL")
        if not url or not re.match(r"^https://[^/\s]+(/\S*)?$", url):
            errors.append(f"GIT_{index}_URL: missing, or not an https:// URL")
            continue
        if ("PASSWORD" in fields) == ("BEARER" in fields):
            errors.append(f"GIT_{index}: exactly one of GIT_{index}_PASSWORD and GIT_{index}_BEARER is expected")
            continue
        entries.append({
            "name": f"GIT_{index}",
            "url": url.rstrip("/"),
            "username": fields.get("USERNAME", DEFAULT_GIT_USERNAME),
            "password": fields.get("PASSWORD"),
            "bearer": fields.get("BEARER"),
        })

    if errors:
        raise ValueError("; ".join(errors))
    return entries, others


class Broker:
    """State of the broker: the secrets and the open groups, shared by the service and the commands."""

    def __init__(self):
        self.lock = threading.Lock()
        self.git_entries = None
        self.others = None
        self.opened = {}
        self.last_used = {}
        self.last_notified = {}

    # --- Groups ---------------------------------------------------------------------------------------

    def _close_expired(self, now):
        for group in list(self.opened):
            if now - self.last_used[group] >= IDLE_SECONDS or now - self.opened[group] >= MAX_SECONDS:
                reason = "idle" if now - self.last_used[group] >= IDLE_SECONDS else "maximum time"
                del self.opened[group]
                del self.last_used[group]
                log(f"group {group} closed ({reason})")

    def _use(self, group):
        """Checks that the secrets are loaded and the group open, and records the use."""
        now = time.monotonic()
        self._close_expired(now)
        if self.git_entries is None:
            self._notify("locked", "Le courtier est verrouillé")
            raise BrokerError(423, "the secret broker is locked: run `claude_broker` on the host to unlock it")
        if group not in self.opened:
            self._notify(group, f"Autorisation requise pour {group}")
            raise BrokerError(403, f"group '{group}' is closed: run `claude_secret allow {group}` on the host")
        self.last_used[group] = now

    def _notify(self, key, text):
        """Spoken notification (agent-notify), at most once per NOTIFY_INTERVAL_SECONDS for the same key, sent in
        the background so that the request isn't held."""
        now = time.monotonic()
        if now - self.last_notified.get(key, -NOTIFY_INTERVAL_SECONDS) < NOTIFY_INTERVAL_SECONDS:
            return
        self.last_notified[key] = now

        def send():
            try:
                subprocess.run(["agent-notify", text], check=False, timeout=10,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                pass

        threading.Thread(target=send, daemon=True).start()

    # --- Service ----------------------------------------------------------------------------------------

    def git_credential(self, request):
        """Answers a `get` request of the Git credential protocol (lines of key=value)."""
        fields, capabilities = {}, set()
        for line in request.splitlines():
            key, _, value = line.partition("=")
            if key == "capability[]":
                capabilities.add(value)
            elif key:
                fields[key] = value
        if fields.get("protocol") != "https" or not fields.get("host"):
            raise BrokerError(400, "only https URLs are served")
        url = f"https://{fields['host']}/{fields.get('path', '')}".rstrip("/")

        with self.lock:
            self._use("git")
            matches = [entry for entry in self.git_entries
                       if url == entry["url"] or url.startswith(entry["url"] + "/")]
            if not matches:
                raise BrokerError(404, f"no Git token in the secrets file for {url}")
            entry = max(matches, key=lambda candidate: len(candidate["url"]))

        if entry["bearer"]:
            if "authtype" not in capabilities:
                raise BrokerError(400, f"{entry['name']} is a Bearer token, which needs Git 2.46 or later")
            return f"capability[]=authtype\nauthtype=Bearer\ncredential={entry['bearer']}\n", url, entry["name"]
        return f"username={entry['username']}\npassword={entry['password']}\n", url, entry["name"]

    def gh_token(self):
        with self.lock:
            self._use("gh")
            token = self.others.get("GH_TOKEN")
        if not token:
            raise BrokerError(404, "no GH_TOKEN in the secrets file")
        return token

    # --- Commands ---------------------------------------------------------------------------------------

    def load(self, text):
        entries, others = parse_secrets(text)
        if not entries and not others:
            raise ValueError("the secrets file is empty (wrong passphrase?)")
        with self.lock:
            self.git_entries, self.others = entries, others
            self.opened.clear()
            self.last_used.clear()
        log(f"unlocked ({len(entries)} Git tokens, {len(others)} other secrets)")
        return f"Secret broker unlocked: {len(entries)} Git tokens, {len(others)} other secrets."

    def lock_secrets(self):
        with self.lock:
            self.git_entries = self.others = None
            self.opened.clear()
            self.last_used.clear()
        log("locked")
        return "Secret broker locked: secrets forgotten, every group closed."

    def allow(self, group):
        if group not in GROUPS:
            raise ValueError(f"unknown group '{group}' (groups: {', '.join(GROUPS)})")
        with self.lock:
            if self.git_entries is None:
                raise ValueError("the secret broker is locked: run `claude_broker` first")
            now = time.monotonic()
            self.opened[group] = now
            self.last_used[group] = now
        log(f"group {group} opened")
        return (f"Group '{group}' open: it closes after {format_duration(IDLE_SECONDS)} without use, "
                f"and in {format_duration(MAX_SECONDS)} at the latest.")

    def revoke(self, group):
        with self.lock:
            groups = list(self.opened) if group == "all" else [group]
            for name in groups:
                if name in self.opened:
                    del self.opened[name]
                    del self.last_used[name]
                    log(f"group {name} closed (revoked)")
        return "Closed: " + (", ".join(groups) if groups else "no open group")

    def status(self):
        with self.lock:
            now = time.monotonic()
            self._close_expired(now)
            if self.git_entries is None:
                lines = ["Secret broker: locked"]
            else:
                lines = [f"Secret broker: unlocked ({len(self.git_entries)} Git tokens, "
                         f"{len(self.others)} other secrets)"]
            for group in GROUPS:
                if group in self.opened:
                    idle_left = IDLE_SECONDS - (now - self.last_used[group])
                    max_left = MAX_SECONDS - (now - self.opened[group])
                    lines.append(f"  {group:<4} open, closes in {format_duration(min(idle_left, max_left))} "
                                 f"(idle limit {format_duration(idle_left)}, maximum {format_duration(max_left)})")
                else:
                    lines.append(f"  {group:<4} closed")
        return "\n".join(lines)

    def unlocked(self):
        with self.lock:
            return self.git_entries is not None


BROKER = Broker()


class ServiceHandler(BaseHTTPRequestHandler):
    """HTTP service of the agent network: the agent containers ask for their secrets here."""

    server_version = "claude-broker"

    def _reply(self, status, body):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _serve(self, action, operation):
        client = self.client_address[0]
        try:
            body, target = action()
            log(f"{client} {operation} {target}: allowed")
            self._reply(200, body)
        except BrokerError as error:
            log(f"{client} {operation}: refused ({error})")
            self._reply(error.status, str(error))

    def do_POST(self):
        if self.path != "/v1/git":
            self._reply(404, "unknown path")
            return
        length = int(self.headers.get("Content-Length") or 0)
        if length > MAX_REQUEST_BYTES:
            self._reply(413, "request too large")
            return
        request = self.rfile.read(length).decode("utf-8", errors="replace")

        def action():
            body, url, name = BROKER.git_credential(request)
            return body, f"{url} ({name})"

        self._serve(action, "git")

    def do_GET(self):
        if self.path != "/v1/token/gh":
            self._reply(404, "unknown path")
            return
        self._serve(lambda: (BROKER.gh_token(), "GH_TOKEN"), "gh")

    def log_message(self, format, *args):
        pass


class AdminHandler(socketserver.StreamRequestHandler):
    """Commands of the host (claude_secret, claude_broker), on a Unix socket inside the broker container."""

    def handle(self):
        try:
            request = json.loads(self.rfile.readline())
            command, args = request.get("command"), request.get("args", [])
            if command == "load":
                message = BROKER.load(request.get("data", ""))
            elif command == "lock":
                message = BROKER.lock_secrets()
            elif command == "allow" and len(args) == 1:
                message = BROKER.allow(args[0])
            elif command == "revoke" and len(args) == 1:
                message = BROKER.revoke(args[0])
            elif command == "status":
                message = BROKER.status()
            elif command == "unlocked":
                message = "unlocked" if BROKER.unlocked() else "locked"
                response = {"ok": BROKER.unlocked(), "message": message}
                self.wfile.write((json.dumps(response) + "\n").encode("utf-8"))
                return
            else:
                raise ValueError(f"unknown command: {command} {' '.join(args)}")
            response = {"ok": True, "message": message}
        except (ValueError, json.JSONDecodeError) as error:
            response = {"ok": False, "message": str(error)}
        self.wfile.write((json.dumps(response) + "\n").encode("utf-8"))


class AdminServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def serve():
    os.makedirs(os.path.dirname(ADMIN_SOCKET), mode=0o700, exist_ok=True)
    if os.path.exists(ADMIN_SOCKET):
        os.unlink(ADMIN_SOCKET)
    admin = AdminServer(ADMIN_SOCKET, AdminHandler)
    os.chmod(ADMIN_SOCKET, 0o600)
    threading.Thread(target=admin.serve_forever, daemon=True).start()
    log(f"started (idle limit {format_duration(IDLE_SECONDS)}, maximum {format_duration(MAX_SECONDS)}); locked")
    ThreadingHTTPServer(("0.0.0.0", PORT), ServiceHandler).serve_forever()


def ctl(args):
    if not args:
        print(__doc__, file=sys.stderr)
        return 2
    request = {"command": args[0], "args": args[1:]}
    if args[0] == "load":
        request["data"] = sys.stdin.read()
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.connect(ADMIN_SOCKET)
            client.sendall((json.dumps(request) + "\n").encode("utf-8"))
            response = json.loads(client.makefile("r", encoding="utf-8").readline())
    except OSError as error:
        print(f"claude-broker: service not ready ({error})", file=sys.stderr)
        return 3
    if args[0] != "unlocked":
        print(response["message"], file=sys.stdout if response["ok"] else sys.stderr)
    return 0 if response["ok"] else 1


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "serve":
        serve()
        return 0
    if len(sys.argv) >= 2 and sys.argv[1] == "ctl":
        return ctl(sys.argv[2:])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
