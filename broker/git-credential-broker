#!/usr/bin/env python3
"""Git credential helper of the agent container (credential.helper=broker): asks the secret broker for the
token of the URL (see README, "Secret broker").

Without BROKER_URL (e.g. in a build container), it answers nothing, and Git goes on with its other settings.
When the broker refuses (group closed, broker locked, no token for the URL) or can't be reached, the reason is
printed to stderr, and `quit=1` stops Git from trying anything else, such as a prompt.
"""

import os
import sys
import urllib.error
import urllib.request


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return 0  # store, erase: the broker keeps nothing from Git
    broker_url = os.environ.get("BROKER_URL")
    if not broker_url:
        return 0

    request = sys.stdin.read()
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(urllib.request.Request(broker_url.rstrip("/") + "/v1/git", data=request.encode("utf-8"),
                                                method="POST"), timeout=10) as response:
            sys.stdout.write(response.read().decode("utf-8"))
            return 0
    except urllib.error.HTTPError as error:
        reason = error.read().decode("utf-8", errors="replace").strip()
    except OSError as error:
        reason = f"secret broker unreachable at {broker_url} ({error}): run `claude_broker` on the host"
    print(f"git-credential-broker: {reason}", file=sys.stderr)
    print("quit=1")
    return 0


if __name__ == "__main__":
    sys.exit(main())
