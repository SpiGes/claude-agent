# Env file of the build container for VS Code (see "Build container for VS Code" in README.md), copied to
# ~/.claude-agent-homes/build.env. It holds the person's own Git tokens and authorship, never the agent's:
# no Claude Code token, no MCP token, no SpiGes secret. Each token is dedicated to the build container,
# distinct from the tokens of the WSL2 host and of the agent, so that it can be revoked on its own.
# Same formats as .env.example: one line per value, no quotes, no trailing space or Windows line ending,
# base64 encoded with `base64 -w0`.

# Azure DevOps PAT of the person, dedicated to the build container (Code, Read & Write).
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=http.https://devops-server.admin.ch.extraHeader
GIT_CONFIG_VALUE_0=Authorization: Basic <PAT in base64, e.g. printf ':%s' '<PAT>' | base64 -w0>

# Commit authorship on the Azure DevOps Server: the person's own name and address. Required: the container
# refuses to start without them.
DEVOPS_COMMIT_NAME=<Firstname Lastname>
DEVOPS_COMMIT_EMAIL=<firstname.lastname@example.org>

# --- Optional: GitHub. ---
# Fine-grained PAT of the person's GitHub account, limited to the repositories pushed from the workspace
# (Contents: Read and write). To enable it, uncomment the four lines below and raise GIT_CONFIG_COUNT.
#GIT_CONFIG_KEY_1=http.https://github.com/.extraHeader
#GIT_CONFIG_VALUE_1=Authorization: Basic <PAT in base64, e.g. printf 'x-access-token:%s' '<PAT>' | base64 -w0>
#GITHUB_COMMIT_NAME=<Firstname Lastname>
#GITHUB_COMMIT_EMAIL=<ID>+<login>@users.noreply.github.com

# --- Optional: Bitbucket. ---
# One HTTP access token per repository (Repository write), created in the settings of the repository, with
# the exact URL of the remote (".git" included). No entry for the whole server: Git would then send two
# tokens to a repository that has its own. One more pair per repository, GIT_CONFIG_COUNT raised each time.
#GIT_CONFIG_KEY_2=http.https://bitbucket.bit.admin.ch/scm/<project>/<repository>.git.extraHeader
#GIT_CONFIG_VALUE_2=Authorization: Bearer <token>
#BITBUCKET_COMMIT_NAME=<Firstname Lastname>
#BITBUCKET_COMMIT_EMAIL=<firstname.lastname@example.org>

# --- Optional: personal CA certificates. ---
# Same as in .env.example, e.g. the certificate of the MinIO used by a local run of the SpiGes backend.
#EXTRA_CA_CERTS_DIR=<folder of the certificates, e.g. /shared/backend-run/certs>
